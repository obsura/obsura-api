# Copy this file to `.env` before running Docker Compose.

# Required images
OBSURA_API_IMAGE=ghcr.io/obsura/obsura-api:replace-me
POSTGRES_IMAGE=postgres:17-alpine

# Required database settings
POSTGRES_DB=obsura
POSTGRES_USER=obsura
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://obsura:change-me@postgres:5432/obsura

# API binding
OBSURA_BIND_HOST=127.0.0.1
OBSURA_PORT=8000

# Optional processing backends
OBSURA_OCR_BACKEND=tesseract
OBSURA_OCR_LANGUAGE=eng
OBSURA_FACE_DETECTOR_BACKEND=opencv
OBSURA_DOCUMENT_EXTRACTOR_BACKEND=pypdf
OBSURA_PII_BACKEND=presidio
OBSURA_PII_LANGUAGE=en
OBSURA_PRESIDIO_MODEL=en_core_web_sm
OBSURA_PRESIDIO_SCORE_THRESHOLD=0.35
OBSURA_TEXT_ANONYMIZER_BACKEND=presidio
# Optional multi-language Presidio settings. Each configured language must have a
# matching model entry and the image must have those spaCy models baked at build
# time. The root Dockerfile now bakes `en_core_web_sm` and `es_core_news_sm` by
# default. Override build-time models with:
# docker build --build-arg OBSURA_SPACY_MODELS="en_core_web_sm es_core_news_sm"
OBSURA_PRESIDIO_SUPPORTED_LANGUAGES=en,es
OBSURA_PRESIDIO_MODEL_MAP={"en":"en_core_web_sm","es":"es_core_news_sm"}
# Optional path to a vetted Presidio YAML recognizer registry.
OBSURA_PRESIDIO_RECOGNIZERS_PATH=
# Optional deployment secret for `mode=hash`. Must be at least 16 bytes.
OBSURA_TEXT_HASH_SALT=replace-with-at-least-16-bytes

# Optional runtime behavior
# Raw source text and raw source files are no longer persisted by workflow jobs.
OBSURA_RETAIN_SOURCE_CONTENT_BY_DEFAULT=false
OBSURA_IMAGE_OUTPUT_FORMAT=PNG
OBSURA_EPHEMERAL_ARTIFACT_TTL_SECONDS=900
OBSURA_MAX_EPHEMERAL_ARTIFACTS=256
# CORS values must be full origins with scheme. Supported aliases:
# `OBSURA_CORS_ALLOWED_ORIGINS`, `CORS_ALLOWED_ORIGINS`,
# `OBSURA_ALLOWED_HOSTS`, or `ALLOWED_HOSTS`.
OBSURA_CORS_ALLOWED_ORIGINS=https://obsura.one,https://app.obsura.one,https://admin.obsura.one
OBSURA_CORS_ALLOW_CREDENTIALS=true

# Optional safety limits
OBSURA_MAX_UPLOAD_BYTES=10485760
OBSURA_MAX_IMAGE_PIXELS=20000000
OBSURA_MAX_BULK_TEXT_ITEMS=50
OBSURA_MAX_BULK_TEXT_ITEM_CHARACTERS=100000
OBSURA_MAX_BULK_TEXT_TOTAL_CHARACTERS=1000000
OBSURA_MAX_DOCUMENT_PAGES=100
OBSURA_MAX_DOCUMENT_EXTRACTED_CHARACTERS=250000
OBSURA_MAX_CSV_ROWS=10000
OBSURA_MAX_CSV_COLUMNS=256
OBSURA_MAX_CSV_CHARACTERS=250000
OBSURA_MAX_STRUCTURED_PAYLOAD_NODES=5000
OBSURA_MAX_STRUCTURED_PAYLOAD_DEPTH=16
OBSURA_MAX_STRUCTURED_PAYLOAD_CHARACTERS=250000
