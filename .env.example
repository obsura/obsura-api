# Local application defaults
OBSURA_ENVIRONMENT=development
OBSURA_API_V1_PREFIX=/api/v1
# Canonical database URL env var: DATABASE_URL
# Supported alias: OBSURA_DATABASE_URL
# In development only, leaving both unset falls back to local SQLite.
# DATABASE_URL=postgresql+psycopg://obsura:password@postgres:5432/obsura
# Optional face detector backend: `noop` or `opencv_haar`
# OBSURA_FACE_DETECTOR_BACKEND=opencv_haar
OBSURA_STORAGE_ROOT=storage
OBSURA_MEDIA_MOUNT_PATH=/media
OBSURA_AUTO_CREATE_SCHEMA=true
OBSURA_RETAIN_SOURCE_CONTENT_BY_DEFAULT=false
OBSURA_IMAGE_OUTPUT_FORMAT=PNG

# Docker Compose deployment values
OBSURA_API_IMAGE=ghcr.io/obsura/obsura-api:dev
OBSURA_BIND_HOST=127.0.0.1
OBSURA_PORT=8000
POSTGRES_DB=obsura
POSTGRES_USER=obsura
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://obsura:change-me@postgres:5432/obsura
