# Local application defaults
OBSURA_ENVIRONMENT=development
OBSURA_API_V1_PREFIX=/api/v1
# Canonical database URL env var: DATABASE_URL
# Supported alias: OBSURA_DATABASE_URL
# In development only, leaving both unset falls back to local SQLite.
# Plain `postgresql://...` and legacy `postgres://...` URLs are accepted and
# normalized internally to the supported `postgresql+psycopg://...` driver.
# DATABASE_URL=postgresql+psycopg://obsura:password@postgres:5432/obsura
# Optional face detector backend: `noop` or `opencv_haar`
# OBSURA_FACE_DETECTOR_BACKEND=opencv_haar
# Optional OCR backend: `noop` or `tesseract`
# OBSURA_OCR_BACKEND=tesseract
# OBSURA_OCR_LANGUAGE=eng
OBSURA_STORAGE_ROOT=storage
OBSURA_MEDIA_MOUNT_PATH=/media
# Development/test only. When true, the app will auto-upgrade the database to
# the current Alembic head on startup. Production must keep this false.
OBSURA_AUTO_CREATE_SCHEMA=false
OBSURA_RETAIN_SOURCE_CONTENT_BY_DEFAULT=false
OBSURA_IMAGE_OUTPUT_FORMAT=PNG
OBSURA_MAX_UPLOAD_BYTES=10485760
OBSURA_MAX_IMAGE_PIXELS=20000000
OBSURA_MAX_BULK_TEXT_ITEMS=50
OBSURA_MAX_BULK_TEXT_ITEM_CHARACTERS=100000
OBSURA_MAX_BULK_TEXT_TOTAL_CHARACTERS=1000000

# Docker Compose deployment values
# Copy this file to `.env` before running `docker compose up -d`.
# The production compose stack reads `.env` directly for interpolation and
# also injects it into the API and migration containers via `env_file`.
OBSURA_API_IMAGE=ghcr.io/obsura/obsura-api:replace-me
POSTGRES_IMAGE=postgres:17-alpine
OBSURA_BIND_HOST=127.0.0.1
OBSURA_PORT=8000
POSTGRES_DB=obsura
POSTGRES_USER=obsura
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://obsura:change-me@postgres:5432/obsura
